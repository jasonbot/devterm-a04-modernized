--- a/src/render/text.c
+++ b/src/render/text.c
@@ -342,10 +342,23 @@
 
 unsigned int kmscon_text_get_rows(struct kmscon_text *txt, unsigned int font_height)
 {
+	unsigned int height, rows;
+
 	if (!txt || !font_height)
 		return 0;
 
-	return kmscon_text_get_height(txt) / font_height;
+	height = kmscon_text_get_height(txt);
+	rows = height / font_height;
+
+	/* The A04 panel wraps its first active lines to the bottom.  After
+	 * rotation the native vertical axis is the displayed horizontal one;
+	 * keep an 8px guard band split between the displayed top and bottom
+	 * edges by dropping a text row. */
+	if ((txt->orientation == OR_RIGHT || txt->orientation == OR_LEFT) &&
+	    rows > 1 && rows * font_height > height - 8)
+		rows--;
+
+	return rows;
 }
 
