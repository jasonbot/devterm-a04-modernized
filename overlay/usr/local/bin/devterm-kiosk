#!/bin/sh
# Launch a browser that renders into the Linux framebuffer console (no X11,
# no Wayland): Carboxyl (Servo) when installed, else Carbonyl (Chromium).
set -eu

url="${1:-https://example.com}"
case "${TERM:-}" in
    linux|dumb|"") export TERM=xterm-256color ;;
esac

# Carboxyl (Servo) is the preferred browser; Carbonyl is the older
# Chromium-based fallback and w3m the last resort.
if [ -x /opt/carboxyl/carboxyl ] && [ -x /usr/local/bin/carboxyl ]; then
    exec /usr/local/bin/carboxyl "$url"
fi

if [ ! -x /opt/carbonyl/carbonyl ]; then
    echo "Neither Carboxyl nor Carbonyl is installed; falling back to w3m." >&2
    exec w3m "$url"
fi

# Chromium's sandbox is unavailable inside the usual single-user setup here.
# --disable-dev-shm-usage keeps it from depending on a large /dev/shm.
exec /opt/carbonyl/carbonyl \
    --no-sandbox \
    --disable-gpu \
    --disable-dev-shm-usage \
    --user-data-dir="${HOME:-/tmp}/.cache/carbonyl" \
    "$url"
