#!/usr/bin/env python3
"""End the devterm-web session when Ctrl+Alt+Q is pressed.

cage is a kiosk compositor and cog has no quit key, and nothing else runs on
the console while the browser owns it.  So this listens to the keyboards
directly: /dev/input/event* is readable by the `input` group, and reading does
not grab the device, so the page still receives every key.  The chord runs
DEVT_WEB_QUIT_CMD (default: pkill -TERM -x cog), which makes cog exit, then
cage exit, and the login screen comes back.
"""

import glob
import os
import select
import struct
import subprocess
import sys

EV_SYN = 0
EV_KEY = 1
KEY_Q = 16
CTRL = (29, 97)   # LEFTCTRL, RIGHTCTRL
ALT = (56, 100)   # LEFTALT, RIGHTALT

# struct input_event: two longs (timeval), u16 type, u16 code, s32 value.
EVENT = struct.Struct("@llHHi")


def main() -> int:
    devices = {}
    for path in glob.glob("/dev/input/event*"):
        try:
            devices[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
        except OSError as exc:
            print(f"devterm-web-quit: {path}: {exc}", file=sys.stderr)
    if not devices:
        print("devterm-web-quit: no readable input devices", file=sys.stderr)
        return 1

    ctrl = alt = False
    command = os.environ.get(
        "DEVT_WEB_QUIT_CMD",
        "pkill -TERM -x cog 2>/dev/null; pkill -TERM -x epiphany 2>/dev/null; "
        "sleep 2; pkill -KILL -x cage 2>/dev/null",
    )

    def rescan() -> None:
        for path in glob.glob("/dev/input/event*"):
            if path in devices.values():
                continue
            try:
                devices[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
            except OSError:
                pass

    while True:
        # Re-scan so a keyboard plugged in after the session started still
        # works; select() returns on the timeout when nothing types.
        ready, _, _ = select.select(list(devices), [], [], 2.0)
        if not ready:
            rescan()
            continue
        for fd in ready:
            try:
                data = os.read(fd, EVENT.size * 64)
            except OSError:
                continue
            for offset in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _sec, _usec, kind, code, value = EVENT.unpack_from(data, offset)
                if kind != EV_KEY:
                    continue
                if code in CTRL:
                    ctrl = value != 0
                elif code in ALT:
                    alt = value != 0
                elif code == KEY_Q and value == 1 and ctrl and alt:
                    subprocess.run(command, shell=True, check=False)
                    return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
