#!/bin/sh
# Runs inside the cage session: rotate the panel output, then start the browser.
#
# The A04 panel is mounted 90 degrees from its native 480x1280 mode; the console
# rotates with fbcon=rotate:1 (90 degrees clockwise), and a Wayland compositor
# needs the matching output transform.  DEVT_WEB_TRANSFORM overrides it.
#
# Escape hatches, since cage is a kiosk compositor: Ctrl+Alt+Q is picked up by
# devterm-web-quit, and touching /tmp/devterm-web-exit does the same from
# another terminal or over ssh.
set -eu
mode=full
if [ "${1:-}" = --kiosk ]; then
    mode=kiosk
    shift
fi
transform=${DEVT_WEB_TRANSFORM:-270}
if command -v wlr-randr >/dev/null 2>&1; then
    out=$(wlr-randr 2>/dev/null | awk 'NF && $1 !~ /^ / { print $1; exit }')
    if [ -n "$out" ]; then
        wlr-randr --output "$out" --transform "$transform" >/dev/null 2>&1 || true
    fi
fi

/usr/local/bin/devterm-web-quit &

rm -f /tmp/devterm-web-exit
(
    while [ ! -e /tmp/devterm-web-exit ]; do
        sleep 1
    done
    pkill -TERM -x cog 2>/dev/null || true
    pkill -TERM -x epiphany 2>/dev/null || true
    sleep 2
    pkill -KILL -x cage 2>/dev/null || true
) &

# Run the browser as a child rather than exec'ing it: cage does not always
# notice that its only client has gone, leaving the app as a zombie and the
# compositor (and devterm-kms) waiting forever.  When the browser exits - the
# window closed, a crash, or the quit chord - tear the session down ourselves.
case $mode in
    kiosk)
        cog "$@" &
        ;;
    *)
        # GNOME Web keeps its state through dconf, which wants a session bus.
        dbus-run-session -- sh -c 'exec epiphany "$@"' sh "$@" &
        ;;
esac
browser=$!

rc=0
wait "$browser" || rc=$?
pkill -TERM -x cage 2>/dev/null || true
sleep 1
pkill -KILL -x cage 2>/dev/null || true
exit "$rc"
