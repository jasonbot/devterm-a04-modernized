#!/bin/sh
# Tiny wrapper around NetworkManager.  With no arguments it opens nmtui;
# "status" prints a one-line Wi-Fi summary for the tmux status bar.
set -eu

if [ "${1:-}" = status ]; then
    if [ "$(nmcli radio wifi 2>/dev/null || echo disabled)" = disabled ]; then
        printf 'Wi-Fi: off'
        exit 0
    fi

    active=$(nmcli -t -f ACTIVE,SSID,SIGNAL dev wifi 2>/dev/null | \
        awk -F: '$1 == "yes" { print $2 ":" $3; exit }')
    if [ -z "$active" ]; then
        printf 'Wi-Fi: disconnected'
        exit 0
    fi

    ssid=${active%:*}
    signal=${active##*:}
    printf 'Wi-Fi: %s %s%%' "$ssid" "$signal"
    exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

if [ "$#" -eq 0 ]; then
    exec nmtui
fi

if [ "$#" -eq 2 ]; then
    exec nmcli device wifi connect "$1" password "$2"
fi

cat >&2 <<EOF
usage: devterm-wifi                 # interactive nmtui
       devterm-wifi SSID PASSWORD
       devterm-wifi status          # one-line summary for tmux
EOF
exit 2
